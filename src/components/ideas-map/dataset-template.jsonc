// <deck-ideas-map> DATASET - fill in for your talk.
// One JSON block. Real words. No placeholders. Delete these // comments for the
// slide attribute (JSON, not JSONC). See the design spec §4 for the full rules.
{
  // ---- topics: ordered groups. Colour-coded, drive reveal / tag / scope. ----
  "topics": [
    { "id": "family",   "name": "People & family" },
    { "id": "animals",  "name": "Animals" },
    { "id": "places",   "name": "Places" }
    // add your talk's domains, most-important first
  ],

  // ---- nodes: the ideas. No coordinates. topics[] is a LIST (a node in two
  //      topics sits between the clusters and takes its FIRST topic's colour). ----
  "nodes": [
    { "id": "man",   "name": "man",   "topics": ["family"] },
    { "id": "woman", "name": "woman", "topics": ["family"] },
    { "id": "king",  "name": "king",  "topics": ["family"] },
    { "id": "queen", "name": "queen", "topics": ["family"] },
    { "id": "bull",  "name": "bull",  "topics": ["animals"] },
    { "id": "cow",   "name": "cow",   "topics": ["animals"] },
    { "id": "france","name": "France","topics": ["places"] },
    { "id": "paris", "name": "Paris", "topics": ["places"] }
  ],

  // ---- links: plain associations. Drive forceLink + drawn on show-links. ----
  "links": [
    { "source": "king", "target": "france" },
    { "source": "cow",  "target": "bull" }
  ],

  // ---- relations: the consistent steps. Each pair is pulled to ONE shared
  //      offset vector so the parallelograms hold. Topic-agnostic. ----
  "relations": [
    { "rel": "gender", "pairs": [["man","woman"],["king","queen"],["bull","cow"]] },
    { "rel": "capital","pairs": [["france","paris"]] }
  ],
  // one authored 2-D direction per rel, coord units, ANY ANGLE.
  // Keep common ones at clearly distinct angles. (Lives in the component as
  // RELATION_OFFSETS - if you add a rel, artefact-builder adds its vector.)
  "_RELATION_OFFSETS_hint": {
    "gender":  [-90, 0],
    "capital": [63, -50]
  },

  // ---- contexts: named constellations for the context slides.
  //      activate="role,industry,product" composes them (union + renormalised
  //      attention budget -> a specific layer sharpens attention). ----
  "contexts": {
    "royalty": {
      "from": "king",
      "nodes": ["king", "queen", "france", "paris"],
      "weights": { "queen": 1, "france": 0.7, "paris": 0.5 }
      // optional "order": [...] for the sequence / causal overlays (spec §12)
    }
  }
}
